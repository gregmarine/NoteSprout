<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The event editor's field height (arc 24 / Z2). `toolbar_button_size` (62dp on this tier) is
         an ICON button matched to the Supernote toolbar; a text field that tall stacked ten times
         pushes the reminders off the panel. 52dp is still a comfortable finger target and is what
         keeps the tallest layout on one screen with room for the note. Icon steppers keep the
         toolbar dimen. -->
    <dimen name="editor_field_height">52dp</dimen>
    <!-- The hairline each bar closes with (top bar below, bottom bar above). A dimen rather than a
         literal so an off-screen render (CalendarRender, arc 31 / HV4) can rebuild the bars' exact
         pixel height — the grid must sit where the ink was written against it. -->
    <dimen name="calendar_bar_rule">1dp</dimen>
</resources>
