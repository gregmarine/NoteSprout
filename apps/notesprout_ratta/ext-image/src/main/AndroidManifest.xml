<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- No launcher activity: the Supernote launcher lists the package anyway (accepted — "Ratta
         being Ratta"); everywhere else only Settings → Apps shows it. -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/ext_label"
        android:roundIcon="@mipmap/ic_launcher_round">

        <service
            android:name=".ImageExporterService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.symmetricalpalmtree.notesproutsn.extension.NOTEBOOK_EXPORTER" />
            </intent-filter>
            <!-- 9, not 2: the version the host must understand, not the one this was built
                 against. This exporter declares ExporterInfo's `delivery` tail as
                 DELIVERY_PER_PAGE, and an API-8 host stops reading the descriptor before that
                 tail: it would see a plain one-file exporter, bake the whole notebook into one
                 bundle, stream it here and report the first page as the whole export. Declaring
                 ExporterContract.MIN_API_VERSION_FOR_DELIVERY makes such a host skip this service
                 at discovery instead (ExtensionContract.API_VERSION, the D3 skew guard). -->
            <meta-data
                android:name="com.symmetricalpalmtree.notesproutsn.extension.API_VERSION"
                android:value="9" />
        </service>
    </application>
</manifest>
